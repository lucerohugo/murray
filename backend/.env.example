# Copiar como .env para desarrollo local.

SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True

# Hosts permitidos separados por coma (en producción: el dominio o la IP del servidor)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origen del frontend que consume la API. Vacío = se permite cualquiera
# Ej: CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Solo con dominio + HTTPS. Ej: https://api.murray.com.ar
CSRF_TRUSTED_ORIGINS=
BEHIND_HTTPS_PROXY=False

# Carpeta de datos (db.sqlite3, media/). Vacío = carpeta backend/
# DATA_DIR=

# Clave que deben enviar el tablero y la carga de datos:
#   Authorization: Bearer <API_SYNC_KEY>     (o header X-API-Key)
# En el frontend va en NEXT_PUBLIC_API_KEY (frontend/.env.local)
# Sin clave solo se puede ver la API logueado en /admin/
API_SYNC_KEY=

# True deja la API abierta sin clave (solo para probar en local, NO en producción)
API_PUBLICA=False

# Texto de "Fuente" en el encabezado del tablero
DATASET_FUENTE=backend
